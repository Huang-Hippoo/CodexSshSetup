<Window x:Class="CodexSshSetup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex SSH Setup" Height="760" Width="1080" MinHeight="650" MinWidth="920"
        Background="{StaticResource PageBackground}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderBrush" Value="#DCE3ED" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,14">
            <TextBlock Text="Codex SSH Setup" FontSize="28" FontWeight="SemiBold" Foreground="#1A2A44" />
            <TextBlock Text="为 Codex Desktop 安全准备 Linux SSH 主机" Foreground="#61708A" Margin="0,4,0,0" />
            <Border Background="#E8F1FF" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                <TextBlock Text="{Binding Headline}" Foreground="#183E75" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14">
            <Border Style="{StaticResource StatusCard}" DataContext="{Binding VpnStatus}"><StackPanel><TextBlock Text="{Binding Glyph}" FontSize="23" Foreground="{Binding Color}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="#68758A" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource StatusCard}" DataContext="{Binding SshStatus}"><StackPanel><TextBlock Text="{Binding Glyph}" FontSize="23" Foreground="{Binding Color}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="#68758A" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource StatusCard}" DataContext="{Binding TunnelStatus}"><StackPanel><TextBlock Text="{Binding Glyph}" FontSize="23" Foreground="{Binding Color}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="#68758A" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource StatusCard}" DataContext="{Binding CodexStatus}"><StackPanel><TextBlock Text="{Binding Glyph}" FontSize="23" Foreground="{Binding Color}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="#68758A" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource StatusCard}" DataContext="{Binding LoginStatus}"><StackPanel><TextBlock Text="{Binding Glyph}" FontSize="23" Foreground="{Binding Color}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="#68758A" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
        </UniformGrid>

        <TabControl Grid.Row="2" Background="White" BorderBrush="#DCE3ED">
            <TabItem Header="首次配置向导">
                <Grid Margin="22">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="首次配置会打开一个系统 OpenSSH 窗口供你输入服务器密码；工具不会读取或保存密码。" TextWrapping="Wrap" Foreground="#8A5600" Margin="0,0,0,12"/>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="服务器 Host / IP"/><TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="SSH 用户名"/><TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="SSH 端口"/><TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="SSH 别名"/><TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="iKuuuVPN HTTP / mixed 端口"/><TextBox Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Command="{Binding CancelCommand}" IsCancel="True" />
                        <Button Content="开始一键配置" Command="{Binding ConfigureCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" AutomationProperties.AutomationId="ConfigureButton" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="日常连接">
                <StackPanel Margin="28">
                    <TextBlock Text="日常模式不会重复安装。它会检查 VPN、免密 SSH、Codex CLI、登录状态和反向隧道。" TextWrapping="Wrap" Foreground="#4B5B72" Margin="0,0,0,18" />
                    <WrapPanel>
                        <Button Content="连接" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="断开" Command="{Binding DisconnectCommand}" />
                        <Button Content="重新检测" Command="{Binding RedetectCommand}" />
                        <Button Content="设备登录" Command="{Binding LoginCommand}" />
                        <Button Content="查看日志文件" Command="{Binding OpenLogsCommand}" />
                        <Button Content="取消当前操作" Command="{Binding CancelCommand}" />
                    </WrapPanel>
                    <Border Background="#FFF7E8" BorderBrush="#F1D39C" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                        <TextBlock Text="Linux 只监听 127.0.0.1:17890。工具不会设置系统代理，也不会修改 Python、R、conda、Slurm 或其他用户环境。" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="运行日志（设备码只显示在这里，不写入磁盘）" FontWeight="SemiBold" Margin="4,0,0,6" />
            <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Background="#101827" Foreground="#D7E1F0" Padding="10" />
        </Grid>
    </Grid>
</Window>
